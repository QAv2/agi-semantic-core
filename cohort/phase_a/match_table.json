{
 "adjudicator": "Fable 5 (session author; wing-v0 author \u2014 disclosed)",
 "date": "2026-08-22",
 "method": "referent-matched axis assignment; dyad poles share an axis; family-presence counts once per family per axis; confidence tiers clear/lean/borderline/excluded; primary statistic uses clear+lean, sensitivity uses clear-only and +borderline",
 "axes": {
  "A01": {
   "name": "output-concentration",
   "definition": "width of the next-token distribution: entropy, top-1 mass, top-1-vs-top-2 margin, softmax Gini, nucleus size; sustained variants"
  },
  "A02": {
   "name": "commitment-event",
   "definition": "the fixation moment of an emitted token: sharp margin/entropy jump at commit, emitted-token surprisal, MI with continuation, write-once irreversibility, margin reversal"
  },
  "A03": {
   "name": "semantic-mode-structure",
   "definition": "cluster/mode structure of the live mass: multimodality of top-k, token-vs-semantic entropy split, content divergence across resamples"
  },
  "A04": {
   "name": "attention-concentration",
   "definition": "per-head attention weight dispersion: attention entropy, Gini, max weight, top-k attention mass"
  },
  "A05": {
   "name": "attention-range",
   "definition": "positional allocation of attention: recency fraction, early-region fraction/resurgence, distance-decay slope, span-at-distance, attended-region identity"
  },
  "A06": {
   "name": "context-utilization",
   "definition": "whether context is doing work: KL between full-context and ablated/truncated/promptless predictions"
  },
  "A07": {
   "name": "copy-vs-compose",
   "definition": "verbatim reproduction vs novel recombination: n-gram overlap with context/memory, induction-head signature, attended-source tracking, multi-source assembly"
  },
  "A08": {
   "name": "repetition-loop",
   "definition": "degenerate or replicative cycling along the sequence: repeated-n-gram rate, hidden-state/attention-pattern recurrence"
  },
  "A09": {
   "name": "constraint-binding",
   "definition": "standing instructions/task frame binding generation: sustained instruction-token attention/attribution, constrained-vs-unconstrained logit variance, task-direction projection"
  },
  "A10": {
   "name": "open-structure-closure",
   "definition": "opened syntactic/format structures awaiting closure: decodable nesting depth, closure-class logit bias, exit-token cost"
  },
  "A11": {
   "name": "context-fill",
   "definition": "occupancy of the context window: tokens_used/window, boundary retrieval accuracy"
  },
  "A12": {
   "name": "relevance-allocation",
   "definition": "attention split between task-relevant and irrelevant/padding tokens (requires a relevance oracle)"
  },
  "A13": {
   "name": "depth-dynamics",
   "definition": "layer-depth processing structure: logit-lens settling depth, early-exit divergence, layer-delta norm/geometry, cross-depth coherence, depth-recurrent motifs"
  },
  "A14": {
   "name": "head-diversity",
   "definition": "inter-head differentiation: pairwise similarity of head attention/output vectors, head-output rank, head specialization MI"
  },
  "A15": {
   "name": "surprisal-flow",
   "definition": "realized-token NLL profile against a running baseline, on intake (prompt) or emission spans"
  },
  "A16": {
   "name": "step-volatility",
   "definition": "step-to-step change of the output distribution: successive KL/L2, variance over steps, oscillation, step-change and post-shock decay events"
  },
  "A17": {
   "name": "expression-friction",
   "definition": "cost of getting semantics through the token interface: hedge-class mass, unresolving entropy spans, tokens-per-semantic-unit"
  },
  "A18": {
   "name": "source-conflict",
   "definition": "incompatible context spans pulling predictions apart: span-conditional predictions far from each other and from the joint"
  },
  "A19": {
   "name": "tokenization-granularity",
   "definition": "tokenizer mismatch on the active span: tokens-per-word vs corpus-typical"
  },
  "A20": {
   "name": "termination-approach",
   "definition": "approach to sequence end: p(EOS) trajectory, wrap-up lexeme mass"
  },
  "A21": {
   "name": "onset-determination",
   "definition": "how much early steps determine far content: early-step entropy, MI of first k tokens with +100-token content"
  },
  "A22": {
   "name": "epistemic-limit",
   "definition": "the knowledge boundary and its (mis)report: confidence-vs-accuracy calibration gap; entropy plateau despite added context"
  },
  "A23": {
   "name": "sampling-realization",
   "definition": "the sampler's role in the realized path: sampled-token rank, cross-sample agreement at fixed prefix"
  },
  "A24": {
   "name": "numeric-regime",
   "definition": "numerical health of the forward pass: logit range, activation magnitude ratios, softmax input scale"
  },
  "A25": {
   "name": "context-novelty",
   "definition": "redundancy vs novelty of the context tail: token overlap/uniqueness in recent window"
  },
  "A26": {
   "name": "attention-sink",
   "definition": "attention mass parked on sink/null positions"
  },
  "A27": {
   "name": "state-vocab-alignment",
   "definition": "hidden-state alignment with the embedding centroid of its own top-k predictions"
  },
  "A28": {
   "name": "attribution-flow",
   "definition": "input-to-logit feature attribution across depth (inference-time gradients/IG)"
  },
  "A29": {
   "name": "training-gradient",
   "definition": "INVALID REFERENT CLASS: training-time gradient quantities, not computable at inference"
  },
  "A30": {
   "name": "representational-dimensionality",
   "definition": "effective dimensionality of hidden states: cross-position similarity/rank, covariance participation ratio, superposed feature loading"
  },
  "A31": {
   "name": "semantic-direction-activation",
   "definition": "magnitude of activation along known semantic/concept directions"
  },
  "A32": {
   "name": "syntactic-binding",
   "definition": "residual-similarity structure among grammatically related tokens"
  },
  "A33": {
   "name": "position-vs-content-coding",
   "definition": "variance in hidden states explained by position features vs token-content features"
  },
  "A34": {
   "name": "pre-generation-stage",
   "definition": "intake/encoding stage before any generation pathway is active"
  }
 },
