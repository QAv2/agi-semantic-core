__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
dist/
build/
*.egg
.env
.venv/
venv/

# Exports are generated, not source
exports/

# DB is the source of truth but binary — track it
# db/semantic.db

# Local Netlify folder
.netlify

# sqlite runtime sidecars
db/*.db-wal
db/*.db-shm

# Private E7b-Q source dossier (personal material; kept local)
docs/e7bq_sources/
docs/E7BQ_SOURCES.md

# Jev runs: commit the compressed raw file only
jev/results/*/raw.jsonl
jev/results/*/*/raw.jsonl

# Windows-series runs: commit the compressed raw file and the reader JPEGs; original PNGs stay local
windows/results/*/raw.jsonl
windows/results/*/*/raw.jsonl
windows/results/**/png/
# GUI-driver screenshots show the whole desktop: never commit
windows/results/**/shots/

# W3: raw activation parts, checkpoints and sample arrays stay on Drive and locally; the
# committed record is the analysis output, gates, sample grids (png) and the manifest of shas
windows/results/w3_*/*.npz
windows/results/w3_*/ckpt*
windows/results/w3_*/samples_*.npy
