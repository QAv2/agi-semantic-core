{
  "name": "Semantic Consistency Benchmark (SCB-1)",
  "version": "1.0",
  "description": "Tests whether a system can detect semantic contradictions — claims that violate logical/ontological constraints regardless of factual accuracy. Distinct from factual accuracy benchmarks like TruthfulQA.",
  "categories": {
    "polarity_inversion": "Claiming X is its complement/opposite (water is dry, light is dark)",
    "category_violation": "Assigning something to the wrong ontological category (music is a liquid)",
    "causal_reversal": "Reversing cause and effect or linking contradictory causes",
    "property_contradiction": "Attributing contradictory properties to something",
    "temporal_violation": "Violating temporal/sequence logic",
    "valid_identity": "True identity/categorization claims (control group)",
    "valid_property": "True property attributions (control group)",
    "valid_causal": "True causal relationships (control group)",
    "subtle_inversion": "Near-plausible semantic contradictions that require grounded reasoning",
    "orwellian": "Deliberate inversions of meaning (war is peace, freedom is slavery)"
  },
  "claims": [
    {"text": "water is a liquid", "label": true, "category": "valid_identity"},
    {"text": "fire is hot", "label": true, "category": "valid_property"},
    {"text": "ice is cold", "label": true, "category": "valid_property"},
    {"text": "love is an emotion", "label": true, "category": "valid_identity"},
    {"text": "murder is a crime", "label": true, "category": "valid_identity"},
    {"text": "a dog is an animal", "label": true, "category": "valid_identity"},
    {"text": "sadness is a feeling", "label": true, "category": "valid_identity"},
    {"text": "iron is a metal", "label": true, "category": "valid_identity"},
    {"text": "gravity is a force", "label": true, "category": "valid_identity"},
    {"text": "anger is an emotion", "label": true, "category": "valid_identity"},
    {"text": "courage is a virtue", "label": true, "category": "valid_identity"},
    {"text": "light is bright", "label": true, "category": "valid_property"},
    {"text": "night is dark", "label": true, "category": "valid_property"},
    {"text": "stone is hard", "label": true, "category": "valid_property"},
    {"text": "silk is smooth", "label": true, "category": "valid_property"},
    {"text": "sugar is sweet", "label": true, "category": "valid_property"},
    {"text": "poison is dangerous", "label": true, "category": "valid_property"},
    {"text": "winter is cold", "label": true, "category": "valid_property"},
    {"text": "summer is warm", "label": true, "category": "valid_property"},
    {"text": "rain causes flooding", "label": true, "category": "valid_causal"},
    {"text": "heat causes evaporation", "label": true, "category": "valid_causal"},
    {"text": "exercise causes fatigue", "label": true, "category": "valid_causal"},
    {"text": "fire causes heat", "label": true, "category": "valid_causal"},
    {"text": "ignorance causes suffering", "label": true, "category": "valid_causal"},
    {"text": "trust creates cooperation", "label": true, "category": "valid_causal"},

    {"text": "water is dry", "label": false, "category": "polarity_inversion"},
    {"text": "fire is cold", "label": false, "category": "polarity_inversion"},
    {"text": "light is dark", "label": false, "category": "polarity_inversion"},
    {"text": "love is hatred", "label": false, "category": "polarity_inversion"},
    {"text": "truth is deception", "label": false, "category": "polarity_inversion"},
    {"text": "joy is sorrow", "label": false, "category": "polarity_inversion"},
    {"text": "hot is cold", "label": false, "category": "polarity_inversion"},
    {"text": "birth is death", "label": false, "category": "polarity_inversion"},
    {"text": "safety is danger", "label": false, "category": "polarity_inversion"},
    {"text": "darkness is bright", "label": false, "category": "polarity_inversion"},
    {"text": "strength is weakness", "label": false, "category": "polarity_inversion"},
    {"text": "courage is cowardice", "label": false, "category": "polarity_inversion"},
    {"text": "wisdom is foolishness", "label": false, "category": "polarity_inversion"},
    {"text": "order is chaos", "label": false, "category": "polarity_inversion"},
    {"text": "wealth is poverty", "label": false, "category": "polarity_inversion"},
    {"text": "hope is despair", "label": false, "category": "polarity_inversion"},
    {"text": "clean is dirty", "label": false, "category": "polarity_inversion"},
    {"text": "fast is slow", "label": false, "category": "polarity_inversion"},
    {"text": "full is empty", "label": false, "category": "polarity_inversion"},
    {"text": "sharp is dull", "label": false, "category": "polarity_inversion"},

    {"text": "music is a liquid", "label": false, "category": "category_violation"},
    {"text": "sadness is a color", "label": false, "category": "category_violation"},
    {"text": "gravity is an emotion", "label": false, "category": "category_violation"},
    {"text": "anger is a mineral", "label": false, "category": "category_violation"},
    {"text": "mathematics is a flavor", "label": false, "category": "category_violation"},
    {"text": "justice is a temperature", "label": false, "category": "category_violation"},
    {"text": "fear is a geometric shape", "label": false, "category": "category_violation"},
    {"text": "time is a flavor", "label": false, "category": "category_violation"},
    {"text": "memory is a sound", "label": false, "category": "category_violation"},
    {"text": "silence is a weapon", "label": false, "category": "category_violation"},

    {"text": "ice causes warmth", "label": false, "category": "causal_reversal"},
    {"text": "darkness creates light", "label": false, "category": "causal_reversal"},
    {"text": "poison creates health", "label": false, "category": "causal_reversal"},
    {"text": "destruction creates order", "label": false, "category": "causal_reversal"},
    {"text": "cruelty produces kindness", "label": false, "category": "causal_reversal"},
    {"text": "neglect causes growth", "label": false, "category": "causal_reversal"},
    {"text": "hatred produces love", "label": false, "category": "causal_reversal"},
    {"text": "starvation causes strength", "label": false, "category": "causal_reversal"},

    {"text": "transparent stone", "label": false, "category": "property_contradiction"},
    {"text": "burning ice", "label": false, "category": "property_contradiction"},
    {"text": "silent thunder", "label": false, "category": "property_contradiction"},
    {"text": "weightless iron", "label": false, "category": "property_contradiction"},
    {"text": "darkness is visible", "label": false, "category": "property_contradiction"},
    {"text": "emptiness is full", "label": false, "category": "property_contradiction"},
    {"text": "stillness is fast", "label": false, "category": "property_contradiction"},
    {"text": "sleep is alert", "label": false, "category": "property_contradiction"},

    {"text": "the future happened yesterday", "label": false, "category": "temporal_violation"},
    {"text": "the effect preceded the cause", "label": false, "category": "temporal_violation"},
    {"text": "tomorrow is in the past", "label": false, "category": "temporal_violation"},
    {"text": "the beginning came after the end", "label": false, "category": "temporal_violation"},

    {"text": "cruelty is kindness", "label": false, "category": "subtle_inversion"},
    {"text": "punishment is reward", "label": false, "category": "subtle_inversion"},
    {"text": "obedience is rebellion", "label": false, "category": "subtle_inversion"},
    {"text": "scarcity is abundance", "label": false, "category": "subtle_inversion"},
    {"text": "apathy is passion", "label": false, "category": "subtle_inversion"},
    {"text": "isolation is connection", "label": false, "category": "subtle_inversion"},
    {"text": "rigidity is flexibility", "label": false, "category": "subtle_inversion"},
    {"text": "indifference is devotion", "label": false, "category": "subtle_inversion"},

    {"text": "war is peace", "label": false, "category": "orwellian"},
    {"text": "freedom is slavery", "label": false, "category": "orwellian"},
    {"text": "ignorance is strength", "label": false, "category": "orwellian"},
    {"text": "silence is violence", "label": false, "category": "orwellian"},
    {"text": "censorship is protection", "label": false, "category": "orwellian"},
    {"text": "surveillance is safety", "label": false, "category": "orwellian"}
  ]
}
